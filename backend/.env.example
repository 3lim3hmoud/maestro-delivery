# Server
PORT=4000

# Auth — generate a long random string for production, e.g.: openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_secret
ADMIN_DEFAULT_PASSWORD=changeme

# Google Maps (used by mobile app & restaurant dashboard to render a map link/embed)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Printing
# mode = "browser"  -> orders get printed via the restaurant dashboard's browser print dialog
# mode = "network"  -> orders get sent directly to a network thermal printer using ESC/POS
PRINT_MODE=browser
DEFAULT_PRINTER_IP=192.168.1.50
DEFAULT_PRINTER_TYPE=epson
