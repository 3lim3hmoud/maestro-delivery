{
  "expo": {
    "name": "المايسترو",
    "slug": "maestro-delivery",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#0D0D0D"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "المايسترو يحتاج موقعك عشان يوصل طلبك بالظبط لمكانك"
      }
    },
    "android": {
      "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION"]
    },
    "extra": {
      "apiBase": "http://192.168.1.8:4000"
    }
  }
}